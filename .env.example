# ─── Datenbank ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://klarwerk:klarwerk@localhost:5433/klarwerk?schema=public"

# ─── App ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ Zeichen. Verschlüsselt Integrations-Tokens & AI-Keys in der Datenbank.
# Erzeugen: openssl rand -base64 48
ENCRYPTION_KEY=""
# Signiert Session-Cookies. Erzeugen: openssl rand -base64 48
SESSION_SECRET=""

# ─── AI Provider ────────────────────────────────────────────────────────────
# Ohne Key läuft Klarwerk im klar gekennzeichneten Demo-Modus (Mock-Provider).
# Ein Key kann hier stehen oder – pro Betrieb – unter Einstellungen › AI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Leer = Standardadresse des SDK (https://api.anthropic.com).
ANTHROPIC_BASE_URL=""
# Denktiefe: low | medium | high | xhigh | max.
# "low" passt zu Einordnen und Auslesen (kurz, häufig, wartende Nutzer);
# für schwierigere Aufgaben höher setzen.
ANTHROPIC_EFFORT="low"
# "aus" schaltet das Nachdenken ab. Bei Aufgaben mit Werkzeugen wirkungslos,
# weil das Modell den Werkzeugaufruf sonst in den sichtbaren Text schreibt.
ANTHROPIC_THINKING="an"
# Stille Wiederholungen des SDK bei Rate-Limits. Die Voreinstellung des SDK (2)
# lässt eine Anfrage mit Backoff auf über eine Minute anwachsen, ohne dass
# jemand erfährt, warum. Für eine Oberfläche ist ein klarer Fehler besser.
ANTHROPIC_MAX_RETRIES="1"
ANTHROPIC_TIMEOUT_SECONDS="60"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ─── E-Mail-Integrationen ───────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Storage (leer = lokaler Dateispeicher unter ./storage) ─────────────────
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Queue / Cache (leer = DB-basierte Queue) ───────────────────────────────
REDIS_URL=""

# ─── Billing ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Plattform-Administration ───────────────────────────────────────────────
PLATFORM_ADMIN_EMAILS=""
